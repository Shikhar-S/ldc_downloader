# LDC downloader configuration.
#
#   cp ldc.env.example ldc.env
#   $EDITOR ldc.env
#   chmod 600 ldc.env
#
# ldc.env is gitignored. Never commit it.
#
# This file is sourced by bash, so quote values that contain spaces, '#', or
# other shell metacharacters. Single quotes are safest for passwords.

LDC_EMAIL='you@example.edu'
LDC_PASSWORD='your-ldc-password'

# Where downloads are written. cookies.txt and corpora.tsv are kept here too.
# Defaults to the current directory if unset.
LDC_DOWNLOAD_DIR='/path/to/ldc_data'
